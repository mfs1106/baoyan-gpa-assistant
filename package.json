{
  "name": "gpa-calculator",
  "private": true,
  "version": "1.0.0",
  "description": "保研绩点助手 - GPA计算、成绩预测、保研排名、课表查询",
  "main": "main.cjs",
  "author": "保研绩点助手",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder build --win"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.315.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.10.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@types/xlsx": "^0.0.36",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "nexe": "^5.0.0-beta.4",
    "pkg": "^5.8.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  },
  "build": {
    "appId": "com.jwxt.software",
    "productName": "保研绩点助手",
    "asar": true,
    "files": [
      "dist/**/*",
      "main.cjs",
      "assets/**/*"
    ],
    "directories": {
      "output": "release-build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
